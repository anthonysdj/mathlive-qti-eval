/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    // The workspace sources below are written for the sandboxes' compiler
    // settings, not this app's stricter style rules
    "noPropertyAccessFromIndexSignature": false,
    "importHelpers": false
  },
  "include": [
    "src/**/*.ts",
    // The plugin and its pipeline are TypeScript sources in the workspace
    "../../sandbox/froala/src/**/*.ts",
    "../../sandbox/converters/src/modules.d.ts",
    "../../sandbox/basic/src/serialize.ts"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
