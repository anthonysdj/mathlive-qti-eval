{
  "name": "@sandbox/converters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:svg-sync": "vite build -c vite.svg-sync.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "compare": "VITE_PROBE=1 vitest run tests/compare-dump.test.ts",
    "gallery": "node scripts/gallery.mjs",
    "print": "node --experimental-strip-types scripts/print-svg.mjs",
    "consistency": "node scripts/consistency.mjs",
    "demo:shot": "node scripts/demo-shot.mjs",
    "size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "mathlive": "0.111.1",
    "temml": "0.14.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "@types/pngjs": "6.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
